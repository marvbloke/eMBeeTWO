10 CLS:W=0:T=1:P=-1:X=4:Y=3:FOR I=0 TO 59:@(I)=0:NEXT I
15 FOR J=0 TO 5:?AT J,8;"|";:NEXT J:FOR I=0 TO 3:@(I)=RND(8):@(I+4)=RND(6):@(I+8)=0:NEXT I
20 ?AT 0,10;"TRN:";T;"/10"
30 FOR I=0 TO 3:?AT I+1,10;"M";I+1;":";:IF @(I+8) ?"FND ";:GOTO 50
40 IF P<0 ?"--- ";:GOTO 50
45 A=P-@(I):IF A<0 A=-A
46 B=Q-@(I+4):IF B<0 B=-B
48 ?A+B;" ";
50 NEXT I:IF W=4 GOTO 200
60 IF T>10 GOTO 300
70 ?AT Y,X;"+";
80 K=INKEY:U=(K=54)+(K=80)-(K=52)-(K=79):Z=(K=50)+(K=65)-(K=56)-(K=81):N=X+U:O=Y+Z:IF (N>=0)*(N<=7) X=N
90 IF (O>=0)*(O<=5) Y=O
100 IF (U=0)*(Z=0)*(K<>53)*(K<>32) GOTO 80
110 V=@((Y-Z)*8+X-U+12):?AT Y-Z,X-U;CHR(32+(V=1)*56+(V=2)*45);:IF (K<>53)*(K<>32) GOTO 70
120 P=X:Q=Y:T=T+1:F=0:FOR I=0 TO 3:IF @(I+8)=0 IF P=@(I) IF Q=@(I+4) @(I+8)=1:W=W+1:F=1:TONE 2000,10
130 NEXT I:IF F=0 TONE 100,10
140 @(Q*8+P+12)=1+F:GOTO 20
200 ?AT 5,10;"YOU WIN!":TONEW 1500,20:GOTO 400
300 ?AT 5,10;"YOU LOSE":TONEW 100,20:FOR I=0 TO 3:?AT @(I+4),@(I);"M";:NEXT I
400 DELAY 3000:GOTO 10