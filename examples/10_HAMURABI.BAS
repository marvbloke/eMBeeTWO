160 IF Q>S ?"NO GRAIN":GOTO 150
170 S=S-Q:C=1
180 ?"PLANT ACRES?";:INPUT D:IF D<0 GOTO 180
185 IF D=0 GOTO 220
200 IF D>A ?"NO ACRES":GOTO 180
