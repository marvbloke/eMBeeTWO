40 CLS:Z=Z+1:IF Z>10 GOTO 400
50 ?"YR ";Z;":";D;" DIED, IN:";I:P=P+I:IF Q>0 GOTO 70
60 P=P/2:?"PLAGUE! 1/2 DIE"
