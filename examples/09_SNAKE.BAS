10 CLS:S=300:L=3:X=10:Y=4:H=0:T=0:D=2:M=2
20 FOR I=0 TO 167:@(I)=0:NEXT I
30 C=Y*21+X:@(C)=1:@(168)=C:?AT Y,X;"#"
40 GOSUB 300
50 K=0:IF K=0 GOTO 100
60 IF (K=50)+(K=81) IF D<>3 D=1
70 IF (K=56)+(K=65) IF D<>1 D=3
80 IF (K=52)+(K=79) IF D<>2 D=4
90 IF (K=54)+(K=80) IF D<>4 D=2
100 IF D=1 Y=Y-1
110 IF D=3 Y=Y+1
120 IF D=4 X=X-1
130 IF D=2 X=X+1
140 IF (X<0)+(X>20)+(Y<0)+(Y>7) GOTO 500
150 C=Y*21+X:IF @(C)=1 GOTO 500
160 @(C)=1:H=H+1:IF H>39 H=0
170 @(168+H)=C:?AT Y,X;"#"
180 IF M>0 M=M-1:GOTO 220
190 E=@(168+T):@(E)=0:?AT E/21,E-E/21*21;" "
200 T=T+1:IF T>39 T=0
210 IF C=F M=1:L=L+1:S=S-15:IF S<50 S=50:GOSUB 300
220 I=S/20:K=0
230 DELAY 20:J=INKEY:IF J>0 K=J
240 I=I-1:IF I>0 GOTO 230
250 GOTO 50
300 F=RND(168):IF @(F)=1 GOTO 300
310 ?AT F/21,F-F/21*21;"O":RETURN
500 ?AT 3,5;"GAME OVER!":?AT 5,4;"SCORE: ";L-3:END