#include <Arduino.h>
#include <Wire.h>

void setup() {
  Serial.begin(115200);
  while (!Serial); // Wait for Serial Monitor on Leonardo/USB chips
  Wire.begin();

  Serial.println(F("\n================================="));
  Serial.println(F("       I2C BUS SCANNER           "));
  Serial.println(F("================================="));
  
  byte count = 0;
  for (byte i = 1; i < 127; i++) {
    Wire.beginTransmission(i);
    if (Wire.endTransmission() == 0) {
      Serial.print(F("Found I2C device at address: 0x"));
      if (i < 16) Serial.print("0");
      Serial.println(i, HEX);
      count++;
    }
  }
  
  if (count == 0) {
    Serial.println(F("No I2C devices found!"));
    Serial.println(F("Check GND, VCC, A4 (SDA), and A5 (SCL) connections."));
  } else {
    Serial.print(F("Scan complete. Total devices found: "));
    Serial.println(count);
  }
  Serial.println(F("=================================\n"));
}

void loop() {
  // Empty loop
}